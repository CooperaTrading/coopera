APP_NAME="Coopera Trading"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Addis_Ababa
APP_URL=http://localhost:8000

APP_CURRENCY=ETB
APP_CURRENCY_SYMBOL=Br
APP_VAT_RATE=15

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database — use SQLite for local dev, switch to MySQL for production
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=coopera_db
# DB_USERNAME=coppera_user
# DB_PASSWORD=P@ssw0rdcoop2026

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

# Mail — uses 'log' driver in dev (writes to storage/logs/laravel.log).
# For production on cPanel, switch MAIL_MAILER to 'smtp' and fill the credentials below.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_SCHEME=null
MAIL_FROM_ADDRESS="info@cooperatrading.com"
MAIL_FROM_NAME="${APP_NAME}"

# Admin notification email (Contact form submissions)
ADMIN_EMAIL=info@cooperatrading.com

# Production SMTP via cPanel (uncomment + set MAIL_MAILER=smtp in production)
# MAIL_MAILER=smtp
# MAIL_HOST=mail.cooperatrading.com
# MAIL_PORT=587
# MAIL_USERNAME=info@cooperatrading.com
# MAIL_PASSWORD=your-cpanel-email-password
# MAIL_ENCRYPTION=tls

VITE_APP_NAME="${APP_NAME}"
